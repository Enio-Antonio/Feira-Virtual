# ==============================================================================
# Feira Virtual — Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores antes de executar.
# NUNCA versione o arquivo .env nem credenciais reais.
# ==============================================================================

# Django & Segurança (em produção, DJANGO_DEBUG=0 exige DJANGO_SECRET_KEY forte)
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-com-mais-de-50-caracteres
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_SWAGGER=0
SECURE_SSL_REDIRECT=0
LOG_LEVEL=INFO

# Banco de Dados (sqlite em dev local ou mysql para produção/Docker)
DB_ENGINE=sqlite
DB_NAME=feira_virtual
DB_USER=feira_user
DB_PASSWORD=troque-esta-senha
DB_HOST=127.0.0.1
DB_PORT=3306
# Usado apenas pelo container MySQL no docker-compose.yml:
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=1
# CORS_ALLOWED_ORIGINS=https://meu-dominio.com.br
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# E-mail (vazio/dev usa console.EmailBackend; configure SMTP em produção)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@feira-virtual.local

# Rate Limiting (DRF Throttling)
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute
THROTTLE_LOGIN=10/minute
THROTTLE_REGISTRO=5/minute
THROTTLE_RECUPERAR_SENHA=5/minute

# Pagamento Pix (Mock em dev; troque em produção ao ligar gateway real)
PIX_WEBHOOK_SECRET=troque-este-segredo-hmac-pix
